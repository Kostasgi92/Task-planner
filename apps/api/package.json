{
  "name": "@tasknest/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "node build.mjs",
    "start": "node --env-file-if-exists=../../.env dist/server.cjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clerk/express": "^2.0.0",
    "@tasknest/contracts": "workspace:*",
    "@tasknest/db": "workspace:*",
    "@tasknest/domain": "workspace:*",
    "drizzle-orm": "^0.45.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "pino": "^9.7.0",
    "pino-http": "^10.5.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.0",
    "esbuild": "^0.25.0",
    "supertest": "^7.1.0",
    "tsx": "^4.20.0",
    "vitest": "^3.2.0"
  }
}
