# --- Database (Neon or local Postgres) ---
# Local: docker compose up -d  (or any Postgres 16+)
DATABASE_URL=postgres://tasknest_owner:tasknest@localhost:5432/tasknest
# Only for `pnpm test` (API integration tests). Must be a separate, disposable database.
TEST_DATABASE_URL=postgres://tasknest_owner:tasknest@localhost:5432/tasknest_test

# --- Clerk (https://dashboard.clerk.com → API keys) ---
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
# Same publishable key, exposed to the browser build.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx
# Optional: comma-separated origins allowed to use session tokens (recommended in production),
# e.g. https://tasknest.vercel.app
CLERK_AUTHORIZED_PARTIES=

# --- API server (local only; on Vercel the API runs as a function) ---
PORT=3001
